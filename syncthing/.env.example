# ================= Syncthing Reporter .env =================
# Report language: en or de
REPORT_LANG=en

# Optional reporter image override
REPORTER_IMAGE=ghcr.io/railsimulatornet/ugreen-nas-syncthing-reporter:latest
# Docker image used for the reporter container.

# Required
SYNCTHING_URL=http://syncthing:8384
# URL to the Syncthing API, using a container name or host/IP.

# Optional API key
# If empty, the reporter tries to read the API key from the mounted config.xml.
ST_API_KEY=

TZ=Europe/Berlin
# Set your local timezone here, for example Europe/Berlin or UTC.

PUID=1000
PGID=10
# Container user/group for Syncthing and the reporter.

REPORT_HOSTNAME=Backup-NAS
# Display name used in the mail subject and report.

RUN_AT=09:45
# Daily execution time in 24-hour HH:MM format, for example 08:00 or 20:30.

PRUNE_DAYS=14
# Delete generated HTML attachments from /state/attach after this many days.

WINDOW_HOURS=24
# Time window in hours for the Changes section.

FOLDER_NAME_MODE=label-then-path
# label           = use only the Syncthing folder label
# path            = use only the folder path
# id              = use only the folder ID
# label-then-path = use the label first and the path as fallback; recommended

LOOKUP_FILE_SIZES=1
# 1 = try to resolve file sizes for changed files
# 0 = skip file-size lookup

CLASSIFY_BY_FIRST_SEEN=1
# 1 = use the first-seen time for cleaner added/changed classification
# 0 = use simpler classification

MERGE_ADD_CHANGE=1
# 1 = use one combined Added / Changed table
# 0 = use separate tables for added and changed items

HIDE_DIR_SIZES=1
# 1 = show a dash instead of a size for directories
# 0 = show a calculated or cached directory size when available

ZERO_SIZE_AS_DASH=1
# 1 = show zero-byte values as a dash
# 0 = show zero-byte values as 0.00 B

TABLE_BYTES_METRIC=binary
# binary  = KiB, MiB, GiB, TiB
# decimal = KB, MB, GB, TB

FAILED_ITEMS_LIMIT=250
# Maximum number of failed items shown in the detailed error section.

FOLDER_ERRORS_LIMIT=250
# Maximum number of folder/API errors collected from Syncthing.

SIZE_CACHE_ENABLED=1
# Helps avoid repeated size lookups for unchanged deleted or changed items.

SIZE_CACHE_FILE=/state/size_cache.json
# Optional custom cache file path. Normally leave the default value.

SIZE_CACHE_TTL_DAYS=90
# Cache retention in days.

SIZE_CACHE_MAX_ENTRIES=200000
# Maximum number of cache entries.

REPORT_TITLE_PREFIX=
# Optional custom mail subject prefix.
# Leave empty to select it automatically based on REPORT_LANG.

# Notifications via Apprise (optional)
APPRISE_ENABLED=0
APPRISE_URL=
APPRISE_TAG=all
APPRISE_URLS=
# APPRISE_ENABLED=1 enables Apprise notifications.
# APPRISE_URL or APPRISE_URLS can contain one or more Apprise URLs.

# SMTP fallback (optional)
SMTP_HOST=smtp.example.com
# SMTP server hostname.

SMTP_PORT=587
# SMTP server port.

SMTP_USER=reporter@example.com
# SMTP username.

SMTP_PASS=CHANGE_ME_SMTP_PASSWORD
# SMTP password.

SMTP_FROM=reporter@example.com
# Sender address for SMTP fallback mail.

SMTP_TO=recipient@example.com
# Recipient address for SMTP fallback mail.

SMTP_STARTTLS=1
# 1 = use STARTTLS if supported
# 0 = do not use STARTTLS

SMTP_SSL=0
# 1 = use implicit SMTP SSL/TLS
# 0 = do not use implicit SMTP SSL/TLS
